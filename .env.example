# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용 (절대 클라이언트 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- 학생 세션 서명 ----------
# 반코드 로그인 학생 세션 JWT 서명용 시크릿 (임의의 긴 랜덤 문자열)
STUDENT_SESSION_SECRET=change-me-to-a-long-random-string

# ---------- OpenAI (샘플 음성 TTS) ----------
OPENAI_API_KEY=sk-...
# 선택: 샘플 음성 보이스 (alloy | echo | fable | onyx | nova | shimmer)
OPENAI_TTS_VOICE=nova

# ---------- Azure Speech (발음 평가) — 선택 ----------
# 설정하면 음소 단위 정밀 발음평가 사용. 비워두면 자동으로 OpenAI(Whisper) 대체 평가 사용.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ---------- LLM 피드백 (Anthropic Claude) ----------
ANTHROPIC_API_KEY=sk-ant-...

# Student Card 재원생 명단 연동 (서버 전용; Student Card의 YUSPEAKING_ROSTER_KEY와 같은 값)
STUDENT_CARD_ROSTER_KEY=

# ---------- 정식 도메인 ----------
# Slack 알림·푸시·복사용 링크에 쓰이는 기본 주소.
# 크론(매일 제출 현황)은 브라우저 요청이 아니라서 이 값이 없으면
# 배포용 주소(...vercel.app)가 링크에 찍힌다. 끝에 / 없이 입력.
NEXT_PUBLIC_APP_URL=https://yuspeaking.yussam.com

# ---------- 공지 푸시 알림 (Web Push / VAPID) ----------
# 비워두면 앱 안 공지는 그대로 동작하고, 휴대폰 푸시만 전송되지 않는다.
# 키 생성: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스에 알리는 연락처 (mailto: 형식)
VAPID_SUBJECT=mailto:admin@yussam.com

# ---------- 음원 자동삭제 크론 보호 (Vercel Cron) ----------
# 임의의 긴 랜덤 문자열. Vercel Cron 이 이 값으로 /api/cron/cleanup 을 인증.
CRON_SECRET=change-me-to-a-long-random-string

# ---------- 카카오 알림톡 (솔라피) ----------
# 월말 리포트를 학부모께 알림톡으로 보낼 때 사용.
# 템플릿 등록 방법은 docs/alimtalk-template.md 참고.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PFID=
SOLAPI_TEMPLATE_ID=
# 알림톡이 막혔을 때 문자로 대체 발송할 발신번호 (미등록 시 대체 발송 안 함)
SOLAPI_SENDER=
